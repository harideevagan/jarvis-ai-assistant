# Copy to .env for local `netlify dev`, or set these as Netlify
# Environment Variables (Site settings > Environment variables) for
# production. Never commit a real .env file.

# LLM backend (OpenAI-compatible chat completions endpoint)
NVIDIA_API_KEY=your-api-key-here
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b

# Optional: lock CORS down to your real domain once deployed
ALLOWED_ORIGIN=*
